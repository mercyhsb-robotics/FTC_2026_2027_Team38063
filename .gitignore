# Built application files
*.apk
*.aar
*.ap_
*.aab

!libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/JDK files
*.class
*.hprof

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# For Mac users
.DS_Store

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/
# Local Claude Code settings (per user, not part of the robot code)
.claude/

# Reference material that is NOT part of the robot code: keep it out of git.
# CAD models and drawing sheets
*.step
*.stp
*.iges
*.igs
*.stl
*.obj
*.glb
*.gltf
*.3mf
*.sldprt
*.sldasm
*.slddrw
*.f3d
*.f3z
*.dwg
*.dxf
*.ipt
*.iam
*.x_t
# Game manuals, datasheets and other downloaded documents (the SDK's licence PDF in doc/legal is kept)
*.pdf
!doc/legal/*.pdf
# Folders for downloaded or scratch research
reference/
research/
downloads/
scratch/
# Python scratch files
__pycache__/
*.pyc
venv/
.venv/
